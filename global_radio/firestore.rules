rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Entitlement fields (isPremium, premium*) are set ONLY by the
    // verifyPurchase Cloud Function via the Admin SDK, which bypasses these
    // rules entirely. Clients may read their own doc and write every other
    // profile field, but any write that changes an entitlement field is
    // rejected here.
    function entitlementFieldsUnchanged() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny(['isPremium', 'premiumProductId', 'premiumPlatform', 'premiumExpiresAt']);
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId &&
        !('isPremium' in request.resource.data) &&
        !('premiumProductId' in request.resource.data) &&
        !('premiumPlatform' in request.resource.data) &&
        !('premiumExpiresAt' in request.resource.data);

      allow update: if request.auth != null && request.auth.uid == userId &&
        entitlementFieldsUnchanged();

      allow delete: if false;
    }

    // Community content requests: any signed-in user may read, create their
    // own request, or increment/decrement `votes` — nothing else on an
    // existing doc.
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
      allow delete: if false;
    }

    // Referral records are written by the app on a successful referral and
    // never read back client-side.
    match /referrals/{referralId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
